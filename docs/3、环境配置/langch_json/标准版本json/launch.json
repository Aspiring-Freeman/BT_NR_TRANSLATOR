{
  "version": "0.2.0",
  "configurations": [
    {
      // 标准的 Launch 一键烧录调试流程
      "name": "BT_NR_TRANSLATOR (fm33le01x) 标准一键调试 (Launch)",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/BT_PassThroughFT.elf",
      "request": "launch", // 1. 更改为标准的 launch 模式
      "type": "cortex-debug",
      "runToEntryPoint": "main", // 2. 告诉插件：启动后自动跑到 main 并停下
      "servertype": "pyocd",
      "targetId": "fm33le01x",
      "showDevDebugOutput": "raw",
      "svdFile": "${workspaceFolder}/VscodeGcc/FM33LE0XX.SVD",
      "swoConfig": {
        "enabled": false
      },
      // 3. 删除了手写的复位跳转指令，完全交给插件原生、安全地打断点和复位
      "rttConfig": {
        "enabled": true,
        "address": "auto",
        "searchSize": 16384,
        "searchId": "SEGGER RTT",
        "polling_interval": 100,
        "decoders": [
          {
            "port": 0,
            "type": "console",
            "label": "RTT Ch0"
          }
        ]
      },
      "liveWatch": {
        "enabled": true,
        "samplesPerSecond": 4
      },
      "serverArgs": [
        "--pack",
        "${workspaceFolder}/VscodeGcc/FM33LE0XX_DFP.1.0.2.pack",
        "--frequency",
        "1000000"
      ],
      "windows": {
        "armToolchainPath": "C:/Program Files (x86)/GNU Arm Embedded Toolchain/10 2021.10/bin",
        "gdbPath": "C:/Program Files (x86)/GNU Arm Embedded Toolchain/10 2021.10/bin/arm-none-eabi-gdb.exe",
        "serverpath": "D:/work/python/pyocd/venv/Scripts/pyocd.exe",
        "preLaunchTask": "PyOCD: Flash (Windows)" // 标准模式下，您也可以将此任务简化为仅编译（如 Build），而把烧录交给 GDB 自动完成。
      },
      "linux": {
        "armToolchainPath": "/usr/bin",
        "gdbPath": "/usr/bin/gdb-multiarch",
        "serverpath": "/home/${env:USER}/Program/PyOCD/venv_new/bin/pyocd",
        "preLaunchTask": "PyOCD: Flash (Linux)"
      }
    },
    {
      "name": "FM33LE0XX Attach",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/BT_PassThroughFT.elf",
      "request": "attach",
      "type": "cortex-debug",
      "servertype": "external",
      "gdbTarget": "localhost:3333",
      "showDevDebugOutput": "raw",
      "svdFile": "${workspaceFolder}/VscodeGcc/FM33LE0XX.SVD",
      "overrideAttachCommands": [
        "monitor reset halt"
      ],
      "windows": {
        "armToolchainPath": "C:/Program Files (x86)/GNU Arm Embedded Toolchain/10 2021.10/bin",
        "gdbPath": "C:/Program Files (x86)/GNU Arm Embedded Toolchain/10 2021.10/bin/arm-none-eabi-gdb.exe"
      },
      "linux": {
        "armToolchainPath": "/usr/bin",
        "gdbPath": "/usr/bin/gdb-multiarch"
      }
    },
    {
      "name": "Cortex Debug (PyOCD RTT)",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/BT_PassThroughFT.elf",
      "request": "launch",
      "type": "cortex-debug",
      "servertype": "pyocd",
      "targetId": "fm33le01x",
      "runToEntryPoint": "main",
      "serverArgs": [
        "--pack",
        "${workspaceFolder}/VscodeGcc/FM33LE0XX_DFP.1.0.2.pack",
        "--frequency",
        "1000000"
      ],
      "rttConfig": {
        "enabled": true,
        "address": "auto",
        "searchSize": 16384,
        "searchId": "SEGGER RTT",
        "polling_interval": 100,
        "decoders": [
          {
            "port": 0,
            "type": "console",
            "label": "RTT Channel 0"
          }
        ]
      },
      "windows": {
        "armToolchainPath": "C:/Program Files (x86)/GNU Arm Embedded Toolchain/10 2021.10/bin",
        "gdbPath": "C:/Program Files (x86)/GNU Arm Embedded Toolchain/10 2021.10/bin/arm-none-eabi-gdb.exe",
        "serverpath": "D:/work/python/pyocd/venv/Scripts/pyocd.exe" // 这里为您补上了 windows 下缺失的 serverpath
      },
      "linux": {
        "armToolchainPath": "/usr/bin",
        "serverpath": "/home/${env:USER}/Program/PyOCD/venv_new/bin/pyocd",
        "gdbPath": "/usr/bin/gdb-multiarch"
      }
    }
  ]
}
